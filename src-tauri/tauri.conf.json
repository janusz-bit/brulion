{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brulion",
  "mainBinaryName": "brulion",
  "version": "../package.json",
  "identifier": "io.github.januszbit.brulion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Brulion",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: http:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: http: ws: wss:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Notatki w Markdown — offline, z kalendarzem i synchronizacją",
    "longDescription": "Brulion to otwartoźródłowa aplikacja do notatek w Markdown działająca offline: dokumenty jak w Obsidianie i konspekty z dziennikami jak w Logseq, zadania, kalendarz, przypomnienia z alarmami, proste obliczenia i tabele. Notatki są zwykłymi plikami .md w folderze, synchronizowanymi przez Syncthing albo Nextcloud (WebDAV). Import i eksport z innych aplikacji.",
    "publisher": "janusz-bit",
    "homepage": "https://github.com/janusz-bit/brulion",
    "license": "AGPL-3.0-or-later",
    "copyright": "© 2026 Brulion contributors, AGPL-3.0-or-later",
    "linux": {
      "deb": {
        "section": "editors"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
