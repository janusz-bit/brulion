{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only plugins (window state; single-instance has no frontend API) and window controls.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "window-state:default",
    "core:window:allow-minimize",
    "core:window:allow-close"
  ]
}
