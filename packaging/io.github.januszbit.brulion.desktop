[Desktop Entry]
Type=Application
Name=Brulion
GenericName=Notes
GenericName[pl]=Notatki
Comment=Offline-first Markdown notes: outliner, journals, calendar, reminders, calculations
Comment[pl]=Notatki w Markdown, także offline: konspekt, dziennik, kalendarz, przypomnienia, obliczenia
Exec=brulion --open %F
Icon=io.github.januszbit.brulion
Terminal=false
Categories=Office;Utility;
# "Otwórz za pomocą → Inny program → Brulion" (docs/NIXOS.md): no MimeType on purpose. A desktop
# without a default for a type (sway, i3, Hyprland without mimeapps.list; GNOME for text/markdown)
# takes the first app in mimeinfo.cache, sorted by name: io.github… comes before nvim, org.gnome…,
# org.kde…, so declaring text/plain made Brulion the default for every text file there.
# Launchers then hand over an activation token (Wayland), which a second launch forwards: the
# running Brulion comes to the front.
StartupNotify=true
Keywords=notes;markdown;outliner;journal;diary;calendar;reminders;tasks;todo;wiki;
Keywords[pl]=notatki;markdown;konspekt;dziennik;kalendarz;przypomnienia;zadania;notes;wiki;
StartupWMClass=brulion
SingleMainWindow=true
X-GNOME-UsesNotifications=true
Actions=capture;today;

[Desktop Action capture]
Name=Quick note
Name[pl]=Szybka notatka
Exec=brulion --capture

[Desktop Action today]
Name=Today's journal
Name[pl]=Dzisiejszy dziennik
Exec=brulion --today
