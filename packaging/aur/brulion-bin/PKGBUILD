# Maintainer: janusz-bit
# Generated by scripts/store-manifests.py (packaging/STORES.md): Brulion's AppImage, unpacked.
pkgname=brulion-bin
pkgver=0.32.0
pkgrel=1
pkgdesc="Offline-first Markdown notes with an outliner, journals and reminders"
arch=('x86_64' 'aarch64')
url="https://github.com/janusz-bit/brulion"
license=('AGPL-3.0-or-later')
depends=('fuse2' 'hicolor-icon-theme')
provides=('brulion')
conflicts=('brulion')
options=('!strip' '!debug')
source_x86_64=("Brulion-0.32.0-x86_64.AppImage::https://github.com/janusz-bit/brulion/releases/download/v0.32.0/Brulion-0.32.0-x86_64.AppImage")
source_aarch64=("Brulion-0.32.0-aarch64.AppImage::https://github.com/janusz-bit/brulion/releases/download/v0.32.0/Brulion-0.32.0-aarch64.AppImage")
sha256sums_x86_64=('2076a98eb427f154faa64b9fda2b2dc5d27b0428fad5ed5386cf8c7c0ae66e25')
sha256sums_aarch64=('5ff94489a01d7321c8a57d1f89b28ab7a21867ddb734afb4e8b2b5a8b1a500f4')

prepare() {
    chmod +x "Brulion-$pkgver-$CARCH.AppImage"
    "./Brulion-$pkgver-$CARCH.AppImage" --appimage-extract > /dev/null
}

package() {
    install -d "$pkgdir/opt/brulion" "$pkgdir/usr/bin"
    cp -a squashfs-root/. "$pkgdir/opt/brulion/"
    for program in brulion brulion-cli; do
        if [[ -e "squashfs-root/usr/bin/$program" ]]; then
            ln -s "/opt/brulion/usr/bin/$program" "$pkgdir/usr/bin/$program"
        fi
    done
    install -Dm644 "squashfs-root/io.github.januszbit.brulion.desktop" "$pkgdir/usr/share/applications/io.github.januszbit.brulion.desktop"
    sed -i 's|^Exec=.*|Exec=brulion %U|' "$pkgdir/usr/share/applications/io.github.januszbit.brulion.desktop"
    for icon in squashfs-root/usr/share/icons/hicolor/*/apps/io.github.januszbit.brulion.*; do
        install -Dm644 "$icon" "$pkgdir/${icon#squashfs-root/}"
    done
}
