# Hash of the benchmark sources (run as `cmake -DSOURCE_DIR=… -DOUTPUT_DIR=… -P sourcehash.cmake`
# on every build by the target brulion_bench_source_hash, see CMakeLists.txt).
#
# Writes, each only when its content changes (so Ninja rebuilds exactly what changed, even when a
# copied tree kept older mtimes than the build — the stale-binary trap that once made a Pi run
# measure old code):
#   <OUTPUT_DIR>/stamps/<file>.sha256   one per source; each suite's objects depend on the stamps
#                                       of its own source and of benchdata.h
#   <OUTPUT_DIR>/benchsourcehash.cpp    the combined hash as a string in every suite's binary
#
# The combined hash is the SHA-256 of the manifest "<sha256>  <file>\n" over the sorted files —
# exactly `sha256sum <files> | sha256sum` in tests/bench, which scripts/bench.sh compares with the
# string in each binary before it measures anything.
cmake_minimum_required(VERSION 3.24)

file(GLOB files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*.cpp" "${SOURCE_DIR}/*.h" "${SOURCE_DIR}/*.cmake"
     "${SOURCE_DIR}/CMakeLists.txt")
list(SORT files)

function(write_if_changed path content)
    if(EXISTS "${path}")
        file(READ "${path}" old)
        if(old STREQUAL content)
            return()
        endif()
    endif()
    file(WRITE "${path}" "${content}")
endfunction()

set(manifest "")
foreach(f IN LISTS files)
    file(SHA256 "${SOURCE_DIR}/${f}" h)
    string(APPEND manifest "${h}  ${f}\n")
    write_if_changed("${OUTPUT_DIR}/stamps/${f}.sha256" "${h}\n")
endforeach()
string(SHA256 combined "${manifest}")

write_if_changed("${OUTPUT_DIR}/benchsourcehash.cpp"
"// Generated by tests/bench/sourcehash.cmake: the hash of the benchmark sources this binary was
// built from (scripts/bench.sh reads the string from the binary and refuses a stale one).
extern const char brulionBenchSourceHash[];
[[gnu::used]] const char brulionBenchSourceHash[] = \"brulion-bench-sources:${combined}\";
")
