<?xml version="1.0"?>
<!--
  Brulion's Android manifest (QT_ANDROID_PACKAGE_SOURCE_DIR = android/, see docs/ANDROID.md).

  Based on Qt 6.11.2's template (src/android/templates/AndroidManifest.xml): androiddeployqt
  fills in the "-%- %%INSERT_... -%-" placeholders (package name, version, app name, the
  library to load) and the permissions Qt modules need. Brulion's own parts: the main activity
  (BrulionActivity, a QtActivity that forwards notification taps to C++), the permissions of
  reminders/alarms and of a vault on shared storage, the alarm receivers and AlarmActivity
  (android/src/io/github/januszbit/brulion/android/), ShareActivity (the share sheet's
  "Brulion": text and text files from other apps), automation (AutomationActivity for brulion://
  links and Tasker's intents, AutomationReceiver, AutomationService in the process ":automation",
  the Quick Settings tiles), the home-screen widgets (TasksWidget,
  CalendarWidget, NotesWidget, their list service and receiver, QuickAddActivity), the background
  check of the notes (BackgroundCheckJob, BackgroundCheckService in the process ":background"), the
  launcher icons, and AgentService (a foreground service while an AI agent on another computer
  answers: the app keeps fetching what it writes with the screen off; its event loop runs in the
  background, android.app.background_running).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="org.qtproject.example"
    android:installLocation="auto"
    android:versionCode="-- %%INSERT_VERSION_CODE%% --"
    android:versionName="-- %%INSERT_VERSION_NAME%% --">

    <!-- The permissions of the Qt modules in use, written here instead of Qt's placeholder
         (androiddeployqt inserts its modules' list only where that placeholder is): Qt Network's
         INTERNET and ACCESS_NETWORK_STATE, Qt Multimedia's MODIFY_AUDIO_SETTINGS (routing the
         sound). Qt Multimedia's CAMERA and BLUETOOTH are left out on purpose: Brulion uses
         neither, and an app that declares CAMERA without holding it may not start the camera app
         (ACTION_IMAGE_CAPTURE, the AI chat's photo: MediaCapture.kt). Qt Core's
         WRITE_EXTERNAL_STORAGE is below, with its maxSdkVersion. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Vault in a Syncthing folder on shared storage ("All files access", Android 11+). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 9 and 10: the classic storage permission (with requestLegacyExternalStorage). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- (ScopedStorage: the app for Google Play leaves these and requestLegacyExternalStorage out,
         android/play/AndroidManifest.xml; lint sees this manifest without it.) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Reminders and alarms. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Android 13+: granted at install to apps whose core function includes reminders. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- An AI agent on another computer answers, or the model on this device does, or a model is
         downloaded or copied (AgentService): a foreground service of type dataSync — the app
         fetches what the agent writes from that computer, a model's files — or specialUse while
         the model computes an answer on the processor, and a wake lock (WAKE_LOCK above) while it
         works. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The app lock's "Use the phone's lock": BiometricPrompt (a normal permission: no prompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Voice notes (docs/UI.md "Voice notes"): the microphone, asked for when a recording starts
         (QMicrophonePermission); a device without one still installs the app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The camera app and the speech recognizer the AI chat asks (MediaCapture.kt): seen by the
         app from Android 11 on only when named here. Those apps take the photo and listen: no
         CAMERA permission, and RECORD_AUDIO above is the voice notes' own. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- %%INSERT_FEATURES -->

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true" />

    <!-- requestLegacyExternalStorage: Android 10 keeps the classic file API on shared storage.
         networkSecurityConfig: HTTPS also trusts the certificate authorities the user installed.
         fullBackupContent (Android 9–11) and dataExtractionRules (Android 12+): the system's
         backup and the transfer to a new phone leave out the passwords and tokens (files/secrets)
         and a model downloaded to run on the device (files/models). -->
    <application
        android:name="org.qtproject.qt.android.bindings.QtApplication"
        android:hardwareAccelerated="true"
        android:label="-- %%INSERT_APP_NAME%% --"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="false"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:fullBackupOnly="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="s">

        <!-- QtActivity + notification taps (path/line extras) forwarded to C++ (AndroidBridge).
             adjustResize: the window is never panned for the keyboard (Qt would pick pan or
             resize per text field); the keyboard's insets reach ImeInsets, and the shell keeps
             the editing toolbar on the keyboard (docs/ANDROID.md, "On-screen keyboard"). -->
        <activity
            android:name="io.github.januszbit.brulion.android.BrulionActivity"
            android:configChanges="orientation|uiMode|screenLayout|screenSize|smallestScreenSize|layoutDirection|locale|fontScale|keyboard|keyboardHidden|navigation|mcc|mnc|density"
            android:windowSoftInputMode="adjustResize|stateUnchanged"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />

            <meta-data
                android:name="android.app.arguments"
                android:value="-- %%INSERT_APP_ARGUMENTS%% --" />

            <!-- Qt's event loop goes on while the activity is in the background (Qt's default
                 stops it until the activity is back): an AI agent on another computer answers
                 with the screen off (AgentService), and what the app does in the background — the
                 "Done" of a notification, a model downloading — is not held up. Android freezes a
                 cached app anyway; the app's own periodic work pauses outside
                 Qt::ApplicationActive, as on a computer whose window is minimised. -->
            <meta-data
                android:name="android.app.background_running"
                android:value="true" />
        </activity>

        <!-- A reminder came due (AlarmManager). -->
        <receiver
            android:name="io.github.januszbit.brulion.android.ReminderReceiver"
            android:exported="false" />

        <!-- Notification buttons "Snooze 10 min" and "OK". -->
        <receiver
            android:name="io.github.januszbit.brulion.android.ActionReceiver"
            android:exported="false" />

        <!-- An alarm rang out with no reaction: silence it (AlarmManager one-shot). -->
        <receiver
            android:name="io.github.januszbit.brulion.android.RingTimeoutReceiver"
            android:exported="false" />

        <!-- Re-arms the stored reminders. System broadcasts reach non-exported receivers;
             other apps cannot. -->
        <receiver
            android:name="io.github.januszbit.brulion.android.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Full-screen alarm over the lock screen (own task, not in Recents). -->
        <activity
            android:name="io.github.januszbit.brulion.android.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.BrulionAlarm" />

        <!-- "Share → Brulion": text and .md/.txt files from other apps (text/* only). No UI
             of its own: it copies the files and hands them to BrulionActivity (docs/ANDROID.md).
             Its own task (the system starts it in the sender's task), not in Recents. -->
        <activity
            android:name="io.github.januszbit.brulion.android.ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/brulion_share_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BrulionShare">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- Automation (docs/ANDROID.md "Automation"): brulion:// links (VIEW: a browser's link, an
             app, `am start -d`) and the explicit RUN intents of Tasker, Automate, MacroDroid. No UI of
             its own, like ShareActivity: what needs the window goes to C++ in this process and
             Brulion comes to the front; a write with the notebook's key runs in the background
             (AutomationService). Everything in the intent is untrusted: C++ checks it. -->
        <activity
            android:name="io.github.januszbit.brulion.android.AutomationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/brulion_automation_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.BrulionShare">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="brulion" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.januszbit.brulion.action.RUN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.januszbit.brulion.action.RUN" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="brulion" />
            </intent-filter>
        </activity>

        <!-- The broadcast form of RUN (sent to this component: implicit broadcasts never reach
             a manifest receiver): only writes with the notebook's key, never a window. -->
        <receiver
            android:name="io.github.januszbit.brulion.android.AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.januszbit.brulion.action.RUN" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.januszbit.brulion.action.RUN" />
                <data android:scheme="brulion" />
            </intent-filter>
        </receiver>

        <!-- The automation requests' own process (a Qt service, as the background check's: Qt
             cannot start a second time in the activity's process). -->
        <service
            android:name="io.github.januszbit.brulion.android.AutomationService"
            android:exported="false"
            android:process=":automation">
            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />
            <meta-data
                android:name="android.app.arguments"
                android:value="--automation" />
        </service>

        <!-- An AI agent on another computer at work for this device (docs/ANDROID.md "An AI agent
             on another computer"), or the model on this device ("A model on the phone"): a
             foreground service in the app's own process with a quiet notification and Stop,
             started and stopped by the app (AgentService.update). specialUse while the model
             computes an answer: Google Play asks why (docs/GOOGLE_PLAY.md), the property says. -->
        <service
            android:name="io.github.januszbit.brulion.android.AgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="An AI model that runs on the device answers the user's question about their notes: it computes on the processor for up to some minutes and must go on while the screen is off or another app is in front. Nothing leaves the device." />
        </service>
        <!-- Its notification's Stop. -->
        <receiver
            android:name="io.github.januszbit.brulion.android.AgentStopReceiver"
            android:exported="false" />

        <!-- Quick Settings tiles (docs/ANDROID.md "Quick Settings tiles and app shortcuts"): quick
             add's window for a note or a task, without starting Qt. Only the system binds them. -->
        <service
            android:name="io.github.januszbit.brulion.android.QuickNoteTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_note"
            android:label="@string/brulion_tile_note"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
        <service
            android:name="io.github.januszbit.brulion.android.QuickTaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_task"
            android:label="@string/brulion_tile_task"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- Home-screen widgets (docs/ANDROID.md "Widgets"): they draw the snapshot the app
             publishes, without starting Qt. The system's APPWIDGET_UPDATE reaches the
             non-exported providers; other apps cannot. -->
        <receiver
            android:name="io.github.januszbit.brulion.android.TasksWidget"
            android:exported="false"
            android:label="@string/brulion_widget_tasks_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>
        <receiver
            android:name="io.github.januszbit.brulion.android.CalendarWidget"
            android:exported="false"
            android:label="@string/brulion_widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>
        <receiver
            android:name="io.github.januszbit.brulion.android.NotesWidget"
            android:exported="false"
            android:label="@string/brulion_widget_notes_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_notes_info" />
        </receiver>

        <!-- The widgets' midnight redraw and the calendar's month buttons and days. -->
        <receiver
            android:name="io.github.januszbit.brulion.android.WidgetReceiver"
            android:exported="false" />

        <!-- The background check of the notes (docs/ANDROID.md "Checking notes in the background"): the
             periodic job (main process: it arms the reminders) and the Qt service it binds, which
             runs Brulion's C++ without any UI in a process of its own (Qt cannot start a second
             time next to the activity; the process ends when the job unbinds). -->
        <service
            android:name="io.github.januszbit.brulion.android.BackgroundCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name="io.github.januszbit.brulion.android.BackgroundCheckService"
            android:exported="false"
            android:process=":background">
            <meta-data
                android:name="android.app.lib_name"
                android:value="-- %%INSERT_APP_LIB_NAME%% --" />
            <meta-data
                android:name="android.app.arguments"
                android:value="--background-check" />
        </service>

        <!-- The rows of the widgets' lists (only the system's widget host may bind it). -->
        <service
            android:name="io.github.januszbit.brulion.android.WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Quick add of the widgets: a dialog over the home screen, its own task, not in Recents. -->
        <activity
            android:name="io.github.januszbit.brulion.android.QuickAddActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/brulion_quick_add_task"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.BrulionQuickAdd"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qtprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/qtprovider_paths" />
        </provider>
    </application>
</manifest>
