<?xml version="1.0" encoding="utf-8"?>
<!-- Android lint configuration of the Gradle project androiddeployqt generates (android/ is
     copied into it). res/values/libs.xml is generated by Qt: its configuration strings are
     not translatable, and our values-pl makes lint expect Polish versions of them. Qt 6.12's
     template brings strings of its own in many languages (values-de, values-fr …), so lint
     expects ours in them too: Brulion speaks English and Polish, and only a string missing in
     Polish is an error (a message that names no Polish is ignored). -->
<lint>
    <issue id="MissingTranslation">
        <ignore path="res/values/libs.xml" />
        <ignore regexp="^(?![\s\S]*\(Polish\))[\s\S]*$" />
    </issue>
    <issue id="UnusedResources">
        <ignore path="res/values/libs.xml" />
    </issue>
</lint>
