<?xml version="1.0" encoding="utf-8"?>
<!-- Android lint configuration of the Gradle project androiddeployqt generates (android/ is
     copied into it). res/values/libs.xml is generated by Qt: its configuration strings are
     not translatable, and our values-en makes lint expect English versions of them. -->
<lint>
    <issue id="MissingTranslation">
        <ignore path="res/values/libs.xml" />
    </issue>
    <issue id="UnusedResources">
        <ignore path="res/values/libs.xml" />
    </issue>
</lint>
