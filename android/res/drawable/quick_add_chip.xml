<?xml version="1.0" encoding="utf-8"?>
<!-- A day / time chip of quick add (QuickAddActivity): picked = filled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_selected" />
            <stroke android:width="1.5dp" android:color="@color/widget_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_faint" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
