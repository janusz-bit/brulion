<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black: an alarm often rings in the dark, and black pixels of an OLED screen are off. -->
    <color name="brulion_alarm_background">#FF000000</color>

    <!-- The alarm slider's actions for accessibility services (AlarmSlider). -->
    <item name="brulion_alarm_action_snooze" type="id" />
    <item name="brulion_alarm_action_ok" type="id" />

    <!-- Theme of AlarmActivity (a plain Activity: no AppCompat theme needed). -->
    <style name="Theme.BrulionAlarm" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brulion_alarm_background</item>
        <item name="android:statusBarColor">@color/brulion_alarm_background</item>
        <item name="android:navigationBarColor">@color/brulion_alarm_background</item>
    </style>

    <!-- Theme of ShareActivity: nothing shown while it copies a share (milliseconds). -->
    <style name="Theme.BrulionShare" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
