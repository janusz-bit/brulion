# Brulion's C++ style (clang-format 21, from `nix develop`): close to the Qt coding style —
# 4 spaces, `Type *ptr` / `Type &ref`, function bodies open on their own line, classes,
# structs, enums and control statements keep the brace on the same line, `// namespace x`
# comments, 120 columns (comments are wrapped at ~100 by hand).
# Format changed lines only: `git clang-format` (CI checks the diff, see .github/workflows/ci.yml).
---
Language: Cpp
BasedOnStyle: WebKit
Standard: c++20
ColumnLimit: 120
IndentWidth: 4
ContinuationIndentWidth: 8
UseTab: Never

BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

PointerAlignment: Right
ReferenceAlignment: Pointer
NamespaceIndentation: None
FixNamespaceComments: true
ShortNamespaceLines: 1
CompactNamespaces: false
IndentCaseLabels: false
IndentPPDirectives: None
AccessModifierOffset: -4

AlignAfterOpenBracket: Align
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: NextLine
BreakInheritanceList: BeforeColon
BreakTemplateDeclarations: Yes
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: true
AllowShortEnumsOnASingleLine: true
InsertBraces: false
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: false
SpaceAfterTemplateKeyword: false
SpacesBeforeTrailingComments: 1
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false
MaxEmptyLinesToKeep: 1

# Keep the include blocks as written, sorted inside each block.
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# Comments starting with these are never reflowed.
CommentPragmas: '^ (SPDX-License-Identifier|NOLINT|clang-format)'

# Qt macros.
ForEachMacros: [Q_FOREACH, foreach, forever, Q_FOREVER, QBENCHMARK, QBENCHMARK_ONCE]
StatementAttributeLikeMacros: [Q_EMIT, emit]
StatementMacros: [Q_UNUSED, QT_REQUIRE_VERSION, Q_OBJECT, Q_GADGET, Q_NAMESPACE, QML_ELEMENT, QML_SINGLETON, QML_UNCREATABLE, QML_ANONYMOUS, QML_VALUE_TYPE, QML_NAMED_ELEMENT]
WhitespaceSensitiveMacros: [QStringLiteral, QByteArrayLiteral, QT_STRINGIFY, QT_TR_NOOP, QT_TRANSLATE_NOOP]
